# What the shell records as it runs: cases, needs, and each plugin's own data
state/

# The brief this build started from; it is not part of the project
PROMPT.md

# Commands the teacher wrote for whoever uses this copy. Each lives in a folder named
# plugin.verb and holds the words it was written for, which are the user's own.
plugins/*.*/

# The student's llama.cpp build and model file, which scripts/setup.sh downloads
runtime/

# Python
__pycache__/
*.pyc
.venv/

# Server and run logs
*.log
